APP_ENV=local
AUTH_DISABLED=false
POSTGRES_DB=site_checker
POSTGRES_USER=site_checker
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=site_checker
RABBITMQ_PASSWORD=change-me
# Ці URL використовують ті самі облікові дані, але username/password мають бути percent-encoded.
DATABASE_URL='postgres://site_checker:change-me@postgres:5432/site_checker?sslmode=disable'
RABBITMQ_URL='amqp://site_checker:change-me@rabbitmq:5672/'
API_KEY=replace-with-random-api-key-32-chars
ALERT_WEBHOOK_URL=
SEED_DEFAULT_LINKS=false
# Docker Compose treats this value as a host path and mounts it read-only into the scheduler.
SEED_URLS_FILE=
